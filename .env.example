# Copy to .env and adjust; docker compose reads it automatically.

# Host user, so files written to the bind mounts belong to you (id -u, id -g).
UID=1000
GID=1000

# Folder with your datasets, mounted at /data. It must exist.
DATA_DIR=./data

# Model weights cache (ALIKED, LightGlue, LoMa; about 2 GB once all are used).
# A name is a Docker volume; a path bind-mounts that host folder instead,
# e.g. /home/francesco/.cache/colmap to reuse what a local install downloaded.
COLMAP_CACHE=colmap-models

# Which compose files to load (colon-separated, later files win). Uncomment ONE
# line for this machine. With none set you get the base file: CPU, no GUI.
#
# NVIDIA GPU:
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# NVIDIA GPU + COLMAP GUI, native Linux:
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.gui.yml
# NVIDIA GPU + COLMAP GUI, WSL2 (GPU-accelerated OpenGL):
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.gui.yml:docker-compose.wslg.yml
# COLMAP GUI without a GPU (software OpenGL):
#COMPOSE_FILE=docker-compose.yml:docker-compose.gui.yml

# --- Advanced image options: the defaults suit most uses ---------------------
# These are read at build time; run `docker compose build` after changing one.

# Python extras installed in the image (see pyproject.toml). Default: cloud
# (open3d). Use `examples` to also run the enrich/ notebooks, or leave the
# value empty (EXTRAS=) for the core only.
#EXTRAS=cloud

# Base image. The default is COLMAP 4.2.1 pinned by digest. For the newest
# release use colmap/colmap:latest and build with --pull.
#COLMAP_IMAGE=colmap/colmap:latest

# cuDNN for ONNX Runtime on the GPU. 0 saves about 1 GB on machines without one.
#WITH_CUDNN=1

# Parallel compile jobs for the pycolmap wheel. Lower it if the build runs out
# of memory.
#BUILD_JOBS=4
